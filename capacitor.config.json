{
  "appId": "com.ludocrown.game",
  "appName": "Ludo Crown",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": ["google.com"]
    }
  },
  "android": {
    "backgroundColor": "#F8FAFC",
    "allowMixedContent": false
  },
  "ios": {
    "backgroundColor": "#F8FAFC",
    "contentInset": "automatic"
  }
}
