rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Hardened Primitives
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBoundedString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidDateString(val) {
      return val is string && val.size() <= 16 && (val == '' || val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function isValidStringList(list, maxLen) {
      return list is list && list.size() <= maxLen && (list.size() == 0 || (list[0] is string && list[0].size() <= 128));
    }

    function isRoomMember(roomId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId)) &&
        request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.playerUids;
    }

    // =========================================================================
    // Entity Validation Blueprints (Anti-Update-Gap Helpers)
    // =========================================================================
    function isValidProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'avatarId', 'avatarFrame', 'boardTheme', 'diceTheme',
          'elo', 'gamesPlayed', 'wins', 'captures', 'sixesRolled', 'winStreak',
          'bestStreak', 'trophies', 'level', 'xp', 'league', 'isPublic',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'avatarId', 'avatarFrame', 'boardTheme', 'diceTheme',
          'elo', 'gamesPlayed', 'wins', 'captures', 'sixesRolled', 'winStreak',
          'bestStreak', 'trophies', 'level', 'xp', 'league', 'isPublic',
          'createdAt', 'updatedAt'
        ]) &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        isValidId(data.uid) &&
        isBoundedString(data.displayName, 2, 32) &&
        isBoundedString(data.avatarId, 1, 64) && data.avatarId.matches('^[a-zA-Z0-9_\\-]+$') &&
        isBoundedString(data.avatarFrame, 1, 64) && data.avatarFrame.matches('^[a-zA-Z0-9_\\-]+$') &&
        isBoundedString(data.boardTheme, 1, 64) && data.boardTheme.matches('^[a-zA-Z0-9_\\-]+$') &&
        isBoundedString(data.diceTheme, 1, 64) && data.diceTheme.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.elo is number && data.elo >= 100 && data.elo <= 5000 &&
        data.gamesPlayed is number && data.gamesPlayed >= 0 && data.gamesPlayed <= 1000000 &&
        data.wins is number && data.wins >= 0 && data.wins <= data.gamesPlayed &&
        data.captures is number && data.captures >= 0 && data.captures <= 10000000 &&
        data.sixesRolled is number && data.sixesRolled >= 0 && data.sixesRolled <= 10000000 &&
        data.winStreak is number && data.winStreak >= 0 && data.winStreak <= 10000 &&
        data.bestStreak is number && data.bestStreak >= 0 && data.bestStreak <= 10000 &&
        data.trophies is number && data.trophies >= 0 && data.trophies <= 100000 &&
        data.level is number && data.level >= 1 && data.level <= 500 &&
        data.xp is number && data.xp >= 0 && data.xp <= 100000000 &&
        data.league in ['bronze', 'silver', 'gold', 'grandmaster'] &&
        data.isPublic is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWallet(data, userId) {
      return data.keys().hasAll([
          'uid', 'coins', 'gems', 'unlockedCosmetics', 'dailyStreak', 'lastDailyClaimDate',
          'dailyChallengesDate', 'challengeProgress', 'claimedChallenges',
          'adRewardedCountToday', 'adDate', 'freeTournamentTickets',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'coins', 'gems', 'unlockedCosmetics', 'dailyStreak', 'lastDailyClaimDate',
          'dailyChallengesDate', 'challengeProgress', 'claimedChallenges',
          'adRewardedCountToday', 'adDate', 'freeTournamentTickets',
          'createdAt', 'updatedAt'
        ]) &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        isValidId(data.uid) &&
        data.coins is number && data.coins >= 0 && data.coins <= 10000000 &&
        data.gems is number && data.gems >= 0 && data.gems <= 1000000 &&
        isValidStringList(data.unlockedCosmetics, 50) &&
        data.dailyStreak is number && data.dailyStreak >= 0 && data.dailyStreak <= 365 &&
        isValidDateString(data.lastDailyClaimDate) &&
        isValidDateString(data.dailyChallengesDate) &&
        data.challengeProgress is map &&
        data.challengeProgress.keys().hasOnly(['rollSixes', 'captures', 'matchesPlayed', 'matchesWon']) &&
        isValidStringList(data.claimedChallenges, 10) &&
        data.adRewardedCountToday is number && data.adRewardedCountToday >= 0 && data.adRewardedCountToday <= 50 &&
        isValidDateString(data.adDate) &&
        data.freeTournamentTickets is number && data.freeTournamentTickets >= 0 && data.freeTournamentTickets <= 20 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRoom(data) {
      return data.keys().hasAll([
          'roomCode', 'hostUid', 'visibility', 'mode', 'maxPlayers', 'entryStake',
          'status', 'openPublic', 'playerUids', 'seats', 'tokens', 'turnIndex', 'diceValue',
          'turnPhase', 'consecutiveSixes', 'winnerColor', 'winnerUid',
          'lastActionText', 'turnCount', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'roomCode', 'hostUid', 'visibility', 'mode', 'maxPlayers', 'entryStake',
          'status', 'openPublic', 'playerUids', 'seats', 'tokens', 'turnIndex', 'diceValue',
          'turnPhase', 'consecutiveSixes', 'winnerColor', 'winnerUid',
          'lastActionText', 'turnCount', 'createdAt', 'updatedAt'
        ]) &&
        isBoundedString(data.roomCode, 6, 6) && data.roomCode.matches('^[A-Z0-9]{6}$') &&
        isValidId(data.hostUid) &&
        data.visibility in ['public', 'private'] &&
        data.mode in ['classic', 'quick'] &&
        data.maxPlayers in [2, 4] &&
        data.entryStake is number && data.entryStake >= 0 && data.entryStake <= 10000 &&
        data.status in ['waiting', 'playing', 'finished'] &&
        data.openPublic is bool &&
        data.openPublic == (data.visibility == 'public' && data.status == 'waiting') &&
        data.playerUids is list && data.playerUids.size() >= 1 && data.playerUids.size() <= 4 &&
        data.playerUids[0] is string && data.playerUids[0].size() <= 128 &&
        data.seats is list && data.seats.size() >= 1 && data.seats.size() <= 4 &&
        data.seats[0] is map &&
        data.tokens is map &&
        data.tokens.keys().hasOnly(['red', 'green', 'yellow', 'blue']) &&
        data.turnIndex is number && data.turnIndex >= 0 && data.turnIndex <= 3 &&
        data.diceValue is number && data.diceValue >= 0 && data.diceValue <= 6 &&
        data.turnPhase in ['roll', 'move'] &&
        data.consecutiveSixes is number && data.consecutiveSixes >= 0 && data.consecutiveSixes <= 3 &&
        isBoundedString(data.winnerColor, 0, 16) &&
        isBoundedString(data.winnerUid, 0, 128) &&
        isBoundedString(data.lastActionText, 0, 120) &&
        data.turnCount is number && data.turnCount >= 0 && data.turnCount <= 10000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidChatMessage(data, roomId) {
      return data.keys().hasAll([
          'roomId', 'senderUid', 'senderName', 'senderColor', 'text',
          'kind', 'visibility', 'participantUids', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'roomId', 'senderUid', 'senderName', 'senderColor', 'text',
          'kind', 'visibility', 'participantUids', 'createdAt'
        ]) &&
        data.roomId == roomId &&
        isValidId(data.roomId) &&
        data.senderUid == request.auth.uid &&
        isValidId(data.senderUid) &&
        isBoundedString(data.senderName, 1, 32) &&
        data.senderColor in ['red', 'green', 'yellow', 'blue'] &&
        isBoundedString(data.text, 1, 160) &&
        data.kind in ['chat', 'emote'] &&
        data.visibility in ['public', 'private'] &&
        data.participantUids is list && data.participantUids.size() >= 1 && data.participantUids.size() <= 4 &&
        data.participantUids[0] is string && data.participantUids[0].size() <= 128 &&
        request.auth.uid in data.participantUids &&
        data.createdAt is timestamp;
    }

    function isValidTournament(data) {
      return data.keys().hasAll([
          'title', 'tier', 'entryFee', 'prizePool', 'maxEntrants', 'status',
          'creatorUid', 'entrantUids', 'entrants', 'winnerUid', 'winnerName',
          'isPublic', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title', 'tier', 'entryFee', 'prizePool', 'maxEntrants', 'status',
          'creatorUid', 'entrantUids', 'entrants', 'winnerUid', 'winnerName',
          'isPublic', 'createdAt', 'updatedAt'
        ]) &&
        isBoundedString(data.title, 3, 64) &&
        data.tier in ['bronze', 'silver', 'gold', 'grandmaster'] &&
        data.entryFee is number && data.entryFee >= 0 && data.entryFee <= 10000 &&
        data.prizePool is number && data.prizePool >= 100 && data.prizePool <= 100000 &&
        data.maxEntrants in [4, 8] &&
        data.status in ['open', 'active', 'completed'] &&
        isValidId(data.creatorUid) &&
        data.entrantUids is list && data.entrantUids.size() >= 1 && data.entrantUids.size() <= 8 &&
        data.entrantUids[0] is string && data.entrantUids[0].size() <= 128 &&
        data.entrants is list && data.entrants.size() >= 1 && data.entrants.size() <= 8 &&
        data.entrants[0] is map &&
        isBoundedString(data.winnerUid, 0, 128) &&
        isBoundedString(data.winnerName, 0, 32) &&
        data.isPublic is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // =========================================================================
    // 1. Public Gaming Profiles & Leaderboard (/profiles/{userId})
    // =========================================================================
    match /profiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId) &&
        (existing().isPublic == true || request.auth.uid == userId);

      allow list: if isSignedIn() && resource.data.isPublic == true;

      allow create: if isVerified() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerified() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Customize avatar, name, or equipped cosmetics
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'avatarId', 'avatarFrame', 'boardTheme', 'diceTheme', 'updatedAt'
          ]) ||
          // Action 2: Record match performance & rating update
          incoming().diff(existing()).affectedKeys().hasOnly([
            'elo', 'gamesPlayed', 'wins', 'captures', 'sixesRolled',
            'winStreak', 'bestStreak', 'trophies', 'level', 'xp', 'league', 'updatedAt'
          ])
        );

      allow delete: if false;
    }

    // =========================================================================
    // 2. Private User Wallet & Rewards (/userWallets/{userId})
    // =========================================================================
    match /userWallets/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      allow list: if false;

      allow create: if isVerified() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidWallet(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerified() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidWallet(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Economy & Cosmetics Purchase / Match Payout
          incoming().diff(existing()).affectedKeys().hasOnly([
            'coins', 'gems', 'unlockedCosmetics', 'freeTournamentTickets', 'updatedAt'
          ]) ||
          // Action 2: Daily Streak & Challenge Progress / Claims
          incoming().diff(existing()).affectedKeys().hasOnly([
            'coins', 'gems', 'dailyStreak', 'lastDailyClaimDate',
            'dailyChallengesDate', 'challengeProgress', 'claimedChallenges', 'updatedAt'
          ]) ||
          // Action 3: Rewarded Video Ad Credit & Daily Quota
          incoming().diff(existing()).affectedKeys().hasOnly([
            'coins', 'gems', 'adRewardedCountToday', 'adDate', 'freeTournamentTickets', 'updatedAt'
          ])
        );

      allow delete: if false;
    }

    // =========================================================================
    // 3. Real-Time Multiplayer Rooms (/rooms/{roomId})
    // =========================================================================
    match /rooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId) &&
        (existing().visibility == 'public' ||
         request.auth.uid in existing().playerUids ||
         existing().status == 'waiting');

      allow list: if isSignedIn() && resource.data.openPublic == true;

      allow create: if isVerified() &&
        isValidId(roomId) &&
        isValidRoom(incoming()) &&
        incoming().hostUid == request.auth.uid &&
        request.auth.uid in incoming().playerUids &&
        incoming().status == 'waiting' &&
        incoming().winnerUid == '' &&
        incoming().winnerColor == '' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerified() &&
        isValidId(roomId) &&
        isValidRoom(incoming()) &&
        existing().status != 'finished' &&
        incoming().hostUid == existing().hostUid &&
        incoming().roomCode == existing().roomCode &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Player joins an open waiting room
          (
            existing().status == 'waiting' &&
            !(request.auth.uid in existing().playerUids) &&
            request.auth.uid in incoming().playerUids &&
            incoming().playerUids.size() == existing().playerUids.size() + 1 &&
            incoming().seats.size() <= existing().maxPlayers &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'playerUids', 'seats', 'lastActionText', 'updatedAt'
            ])
          ) ||
          // Action 2: Non-host player leaves a waiting room
          (
            existing().status == 'waiting' &&
            request.auth.uid != existing().hostUid &&
            request.auth.uid in existing().playerUids &&
            !(request.auth.uid in incoming().playerUids) &&
            incoming().playerUids.size() == existing().playerUids.size() - 1 &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'playerUids', 'seats', 'lastActionText', 'updatedAt'
            ])
          ) ||
          // Action 3: Host starts the match (optionally filling bot seats)
          (
            existing().status == 'waiting' &&
            existing().hostUid == request.auth.uid &&
            incoming().status == 'playing' &&
            incoming().openPublic == false &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'openPublic', 'seats', 'tokens', 'turnIndex', 'diceValue',
              'turnPhase', 'lastActionText', 'updatedAt'
            ])
          ) ||
          // Action 4: Active room member plays a turn (roll dice / move token / finish game)
          (
            existing().status == 'playing' &&
            request.auth.uid in existing().playerUids &&
            incoming().playerUids == existing().playerUids &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'tokens', 'turnIndex', 'diceValue', 'turnPhase', 'consecutiveSixes',
              'status', 'winnerColor', 'winnerUid', 'lastActionText', 'turnCount', 'updatedAt'
            ])
          )
        );

      allow delete: if isVerified() &&
        isValidId(roomId) &&
        existing().hostUid == request.auth.uid &&
        existing().status == 'waiting';

      // =======================================================================
      // 3b. Room Live Chat Subcollection (/rooms/{roomId}/messages/{messageId})
      // =======================================================================
      match /messages/{messageId} {
        allow get: if isSignedIn() &&
          isValidId(roomId) &&
          isValidId(messageId) &&
          isRoomMember(roomId);

        allow list: if isSignedIn() &&
          isValidId(roomId) &&
          (resource.data.visibility == 'public' || request.auth.uid in resource.data.participantUids);

        allow create: if isVerified() &&
          isValidId(roomId) &&
          isValidId(messageId) &&
          isValidChatMessage(incoming(), roomId) &&
          incoming().createdAt == request.time &&
          isRoomMember(roomId);

        allow update: if false;
        allow delete: if false;
      }
    }

    // =========================================================================
    // 4. Competitive League Tournaments (/tournaments/{tournamentId})
    // =========================================================================
    match /tournaments/{tournamentId} {
      allow get: if isSignedIn() && isValidId(tournamentId) && existing().isPublic == true;

      allow list: if isSignedIn() && resource.data.isPublic == true;

      allow create: if isVerified() &&
        isValidId(tournamentId) &&
        isValidTournament(incoming()) &&
        incoming().creatorUid == request.auth.uid &&
        request.auth.uid in incoming().entrantUids &&
        incoming().status == 'open' &&
        incoming().winnerUid == '' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerified() &&
        isValidId(tournamentId) &&
        isValidTournament(incoming()) &&
        existing().status != 'completed' &&
        incoming().creatorUid == existing().creatorUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Player registers into an open tournament
          (
            existing().status == 'open' &&
            !(request.auth.uid in existing().entrantUids) &&
            request.auth.uid in incoming().entrantUids &&
            incoming().entrantUids.size() == existing().entrantUids.size() + 1 &&
            incoming().entrantUids.size() <= existing().maxEntrants &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'entrantUids', 'entrants', 'status', 'updatedAt'
            ])
          ) ||
          // Action 2: Enrolled player records tournament victory completion
          (
            request.auth.uid in existing().entrantUids &&
            incoming().status == 'completed' &&
            incoming().winnerUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'winnerUid', 'winnerName', 'updatedAt'
            ])
          )
        );

      allow delete: if false;
    }
  }
}
